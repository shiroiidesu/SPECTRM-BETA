<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SPECTRM</AssemblyName>
    <RootNamespace>Spectrm</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Only the few native DLLs get unpacked (to %TEMP%\.net); the .NET assemblies load straight from the exe.
         IncludeAllContentForSelfExtract used to unpack all ~140 MB on every new build and filled up C:. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>SPECTRM.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>SPECTRM</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- The installer is its own project (installer\SpectrmSetup.csproj); keep its files out of the app. -->
    <Compile Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <EmbeddedResource Include="SPECTRM.ico" LogicalName="SPECTRM.ico" />
  </ItemGroup>
</Project>
